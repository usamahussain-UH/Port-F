## Frontend – enables the "Live" tab in the AI Playground
VITE_LIVE_CHAT=1

## Backend – Groq inference (https://console.groq.com)
GROQ_API_KEY=YOUR_GROQ_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

## Email service configuration (for contact form)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here

## Server port (must match vite proxy target)
PORT=8787
